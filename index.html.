/* ---------------------------------------------------------------
   STATE + STORAGE
--------------------------------------------------------------- */
let data = JSON.parse(JSON.stringify(DEFAULT_DATA));
let activeBlock = "howto";
const STORAGE_KEY = "ousau-guia-respostas-v1";

async function loadData(){
  try{
    const res = await window.storage.get(STORAGE_KEY, false);
    if(res && res.value){
      const saved = JSON.parse(res.value);
      // merge: keep saved if present, else defaults
      data = saved;
    }
  }catch(e){
    // no saved data yet — use defaults
  }
  render();
}

async function persist(){
  try{
    await window.storage.set(STORAGE_KEY, JSON.stringify(data), false);
    flashSaveIndicator();
  }catch(e){
    console.error("Erro ao salvar:", e);
  }
}

function flashSaveIndicator(){
  const el = document.getElementById("save-indicator");
  el.textContent = "salvo agora";
  setTimeout(()=>{ el.textContent = "conteúdo editável — salvo neste dispositivo"; }, 1800);
}

/* ---------------------------------------------------------------
   RENDER
--------------------------------------------------------------- */
function render(){
  renderNav();
  renderMain();
}

function renderNav(){
  const nav = document.getElementById("nav");
  nav.innerHTML = "";
  data.blocks.forEach(b=>{
    const btn = document.createElement("button");
    btn.className = "nav-btn" + (b.id===activeBlock ? " active" : "");
    btn.innerHTML = `<span class="dot" style="background:${b.dot}"></span>${b.isHowTo ? "Como usar" : b.num + " · " + b.label}`;
    btn.onclick = ()=>{ activeBlock = b.id; render(); };
    nav.appendChild(btn);
  });
}

function renderMain(){
  const main = document.getElementById("main");
  main.innerHTML = "";
  const block = data.blocks.find(b=>b.id===activeBlock);
  if(!block) return;

  if(block.isHowTo){
    main.appendChild(renderHowTo());
    return;
  }

  const view = document.createElement("div");
  view.className = "view active";

  const head = document.createElement("div");
  head.className = "block-head";
  head.innerHTML = `
    <h2><span class="block-num">${block.num}</span> ${block.label}</h2>
    <p class="block-desc">${block.desc}</p>
  `;
  view.appendChild(head);

  const searchRow = document.createElement("div");
  searchRow.className = "search-row";
  searchRow.innerHTML = `
    <input type="text" id="search-input" placeholder="Buscar resposta neste bloco…">
    <button class="add-btn" id="add-card-btn">+ Nova resposta</button>
  `;
  view.appendChild(searchRow);

  const cardsWrap = document.createElement("div");
  cardsWrap.className = "cards";
  cardsWrap.id = "cards-wrap";
  view.appendChild(cardsWrap);

  main.appendChild(view);

  renderCards(block, "");

  document.getElementById("search-input").addEventListener("input", (e)=>{
    renderCards(block, e.target.value.toLowerCase());
  });
  document.getElementById("add-card-btn").addEventListener("click", ()=>{
    block.cards.push({ title:"Nova resposta padrão", text:"Escreva aqui o texto da resposta. Use {{CAMPO}} para marcar um campo de preenchimento." });
    persist();
    renderCards(block, document.getElementById("search-input").value.toLowerCase());
  });
}

function renderCards(block, filter){
  const wrap = document.getElementById("cards-wrap");
  wrap.innerHTML = "";
  const cards = block.cards.filter(c =>
    !filter || c.title.toLowerCase().includes(filter) || c.text.toLowerCase().includes(filter)
  );
  if(cards.length===0){
    wrap.innerHTML = `<div class="empty-state">Nenhuma resposta encontrada com esse termo.</div>`;
    return;
  }
  cards.forEach((card)=>{
    const idx = block.cards.indexOf(card);
    wrap.appendChild(renderCard(block, card, idx));
  });
}

function renderCard(block, card, idx){
  const el = document.createElement("div");
  el.className = "card";
  el.style.setProperty("--card-color", block.color);

  const head = document.createElement("div");
  head.className = "card-head";
  head.innerHTML = `
    <h3>${escapeHtml(card.title)}</h3>
    <div class="card-actions">
      <button class="icon-btn" data-action="edit">✎ editar</button>
      <button class="icon-btn" data-action="copy">⧉ copiar</button>
      <button class="icon-btn" data-action="delete">✕</button>
    </div>
  `;
  el.appendChild(head);

  const body = document.createElement("div");
  body.className = "card-body";
  const textDiv = document.createElement("div");
  textDiv.className = "tmpl-text";
  textDiv.innerHTML = renderTemplateHTML(card.text);
  body.appendChild(textDiv);

  const hasFields = /\{\{.*?\}\}/.test(card.text);
  const note = document.createElement("div");
  note.className = "card-note";
  note.textContent = hasFields
    ? "Clique nos campos amarelos para preencher antes de copiar."
    : "Sem campos de preenchimento — pronto para copiar.";
  body.appendChild(note);

  el.appendChild(body);

  // COPY
  head.querySelector('[data-action="copy"]').onclick = (e)=>{
    const finalText = getFilledText(textDiv);
    navigator.clipboard.writeText(finalText).then(()=>{
      showToast("Resposta copiada.");
      const btn = e.currentTarget;
      btn.classList.add("copied");
      setTimeout(()=>btn.classList.remove("copied"), 1200);
    });
  };

  // EDIT (title + raw template)
  head.querySelector('[data-action="edit"]').onclick = ()=>{
    const editing = textDiv.getAttribute("contenteditable") === "true";
    if(!editing){
      // switch to raw-edit mode: show {{FIELD}} syntax literally
      textDiv.setAttribute("contenteditable","true");
      textDiv.innerText = card.text;
      textDiv.focus();
      head.querySelector('[data-action="edit"]').textContent = "✓ salvar";
    }else{
      card.text = textDiv.innerText;
      textDiv.removeAttribute("contenteditable");
      textDiv.innerHTML = renderTemplateHTML(card.text);
      head.querySelector('[data-action="edit"]').textContent = "✎ editar";
      persist();
      attachFillListeners(el);
    }
  };

  // DELETE
  head.querySelector('[data-action="delete"]').onclick = ()=>{
    if(confirm("Remover esta resposta do guia?")){
      block.cards.splice(idx,1);
      persist();
      renderMain();
    }
  };

  // title double-click to rename
  head.querySelector("h3").ondblclick = ()=>{
    const newTitle = prompt("Renomear resposta:", card.title);
    if(newTitle && newTitle.trim()){
      card.title = newTitle.trim();
      persist();
      renderMain();
    }
  };

  attachFillListeners(el);
  return el;
}

function attachFillListeners(cardEl){
  cardEl.querySelectorAll(".fill").forEach(span=>{
    span.addEventListener("blur", ()=>{}); // values live only in DOM until copy; simple by design
  });
}

function renderTemplateHTML(text){
  const escaped = escapeHtml(text);
  return escaped.replace(/\{\{(.*?)\}\}/g, (m, label)=>{
    return `<span class="fill" contenteditable="true" data-placeholder="${escapeHtml(label.trim())}"></span>`;
  });
}

function getFilledText(textDiv){
  const clone = textDiv.cloneNode(true);
  clone.querySelectorAll(".fill").forEach(span=>{
    const val = span.textContent.trim();
    span.replaceWith(val ? val : `[${span.getAttribute("data-placeholder")}]`);
  });
  return clone.innerText;
}

function escapeHtml(str){
  const d = document.createElement("div");
  d.innerText = str;
  return d.innerHTML;
}

function showToast(msg){
  const t = document.getElementById("toast");
  t.textContent = msg;
  t.classList.add("show");
  setTimeout(()=>t.classList.remove("show"), 1600);
}

