<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Guia de Respostas Padrão — Ouvidoria de Saúde/OGE-MG</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#173252;
    --navy-deep:#0d1f36;
    --teal:#1e7f7a;
    --coral:#c2543f;
    --gold:#c99a2e;
    --green:#3d7a54;
    --paper:#f3f0e7;
    --paper-2:#ece7d8;
    --ink:#1b2430;
    --ink-soft:#5b6472;
    --line:#d8d1bd;
    --fill-bg:#fff3c4;
    --fill-bg-active:#ffe89a;
    --white:#fffdf8;
    --radius:2px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'DM Sans',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .stamp{
    font-family:'Space Mono',monospace;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  /* ===== HEADER ===== */
  header.top{
    background:var(--navy-deep);
    color:var(--paper);
    padding:36px 28px 30px;
    position:relative;
    overflow:hidden;
    border-bottom:6px solid var(--gold);
  }
  header.top::before{
    content:"";
    position:absolute; inset:0;
    background-image:
      radial-gradient(circle at 85% 15%, rgba(201,154,46,.14), transparent 40%),
      radial-gradient(circle at 15% 90%, rgba(30,127,122,.18), transparent 45%);
    pointer-events:none;
  }
  .top-inner{position:relative; max-width:1100px; margin:0 auto;}
  .eyebrow{
    font-family:'Space Mono',monospace;
    font-size:11.5px;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:#e3b94a;
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:14px;
  }
  .eyebrow::before{content:"●"; color:#e3b94a; font-size:8px;}
  h1.title{
    margin:0 0 8px;
    font-size:clamp(28px,4.2vw,44px);
    font-weight:800;
    line-height:1.05;
    letter-spacing:-.01em;
  }
  h1.title span{color:#8fc7c2;}
  .subtitle{
    max-width:640px;
    color:#c9d2dd;
    font-size:15px;
    line-height:1.6;
    margin:0 0 20px;
  }
  .top-meta{
    display:flex; flex-wrap:wrap; gap:10px;
    font-family:'Space Mono',monospace;
    font-size:11px;
  }
  .meta-chip{
    border:1px solid rgba(255,255,255,.22);
    padding:5px 10px;
    border-radius:20px;
    color:#dbe3ec;
  }

  /* ===== NAV ===== */
  nav.blocks{
    position:sticky; top:0; z-index:40;
    background:var(--paper);
    border-bottom:2px solid var(--ink);
    display:flex;
    overflow-x:auto;
    scrollbar-width:none;
  }
  nav.blocks::-webkit-scrollbar{display:none;}
  .nav-btn{
    flex:0 0 auto;
    padding:14px 18px;
    font-family:'Space Mono',monospace;
    font-size:11.5px;
    letter-spacing:.05em;
    text-transform:uppercase;
    background:none;
    border:none;
    border-right:1px solid var(--line);
    cursor:pointer;
    color:var(--ink-soft);
    display:flex; align-items:center; gap:8px;
    white-space:nowrap;
    transition:background .15s ease, color .15s ease;
  }
  .nav-btn .dot{width:8px;height:8px;border-radius:50%; flex:0 0 auto;}
  .nav-btn:hover{background:var(--paper-2); color:var(--ink);}
  .nav-btn.active{background:var(--ink); color:var(--paper);}
  .nav-btn.active .dot{outline:2px solid var(--paper); outline-offset:2px;}

  /* ===== MAIN ===== */
  main{max-width:1100px; margin:0 auto; padding:34px 24px 90px;}
  .view{display:none;}
  .view.active{display:block; animation:fade .35s ease;}
  @keyframes fade{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;}}

  .block-head{
    display:flex; justify-content:space-between; align-items:flex-end;
    gap:20px; margin-bottom:22px; flex-wrap:wrap;
    border-bottom:2px solid var(--ink); padding-bottom:14px;
  }
  .block-head h2{
    margin:0; font-size:26px; font-weight:800; letter-spacing:-.01em;
    display:flex; align-items:center; gap:12px;
  }
  .block-num{
    font-family:'Space Mono',monospace;
    font-size:13px;
    color:var(--white);
    background:var(--ink);
    padding:4px 9px;
  }
  .block-desc{color:var(--ink-soft); font-size:13.5px; max-width:420px;}

  .search-row{
    display:flex; gap:10px; margin-bottom:22px; flex-wrap:wrap;
  }
  .search-row input{
    flex:1; min-width:220px;
    padding:10px 14px;
    border:2px solid var(--ink);
    background:var(--white);
    font-family:'DM Sans',sans-serif;
    font-size:14px;
  }
  .add-btn{
    font-family:'Space Mono',monospace;
    font-size:11.5px;
    text-transform:uppercase;
    letter-spacing:.04em;
    background:var(--ink);
    color:var(--paper);
    border:none;
    padding:10px 16px;
    cursor:pointer;
  }
  .add-btn:hover{background:var(--navy);}

  /* cards */
  .cards{display:flex; flex-direction:column; gap:16px;}
  .card{
    background:var(--white);
    border:1.5px solid var(--ink);
    box-shadow:5px 5px 0 var(--card-color, var(--navy));
    padding:0;
  }
  .card-head{
    display:flex; justify-content:space-between; align-items:center;
    padding:12px 16px;
    background:var(--card-color, var(--navy));
    color:var(--white);
  }
  .card-head h3{margin:0; font-size:15.5px; font-weight:700;}
  .card-actions{display:flex; gap:6px;}
  .icon-btn{
    background:rgba(255,255,255,.14);
    border:1px solid rgba(255,255,255,.35);
    color:var(--white);
    font-family:'Space Mono',monospace;
    font-size:10.5px;
    text-transform:uppercase;
    letter-spacing:.03em;
    padding:5px 9px;
    cursor:pointer;
    border-radius:20px;
  }
  .icon-btn:hover{background:rgba(255,255,255,.28);}
  .icon-btn.copied{background:#fff; color:var(--card-color,var(--navy));}

  .card-body{padding:16px;}
  .tmpl-text{
    font-size:14.5px; line-height:1.7; color:var(--ink);
    white-space:pre-wrap;
  }
  .tmpl-text[contenteditable="true"]{
    outline:2px dashed var(--card-color,var(--navy));
    outline-offset:6px;
    padding:4px;
  }
  .fill{
    background:var(--fill-bg);
    border-bottom:2px solid var(--gold);
    padding:1px 5px;
    font-weight:600;
    cursor:text;
    border-radius:2px;
  }
  .fill:focus{background:var(--fill-bg-active); outline:none;}
  .fill:empty::before{
    content:attr(data-placeholder);
    color:#8a7a3d;
    font-weight:500;
  }
  .card-note{
    margin-top:12px; padding-top:10px; border-top:1px dashed var(--line);
    font-size:11.5px; color:var(--ink-soft);
    display:flex; align-items:center; gap:6px;
  }

  .empty-state{
    border:2px dashed var(--line);
    padding:30px; text-align:center;
    color:var(--ink-soft); font-size:13.5px;
  }

  /* how-to view */
  .howto-grid{display:grid; grid-template-columns:1fr 1fr; gap:26px;}
  @media (max-width:700px){.howto-grid{grid-template-columns:1fr;}}
  .step{
    display:flex; gap:14px; padding:16px 0; border-bottom:1px solid var(--line);
  }
  .step-num{
    font-family:'Space Mono',monospace; font-weight:700; font-size:20px;
    color:var(--white); background:var(--ink); width:34px;height:34px;
    display:flex; align-items:center; justify-content:center; flex:0 0 auto;
  }
  .step h4{margin:0 0 4px; font-size:14.5px;}
  .step p{margin:0; font-size:13px; color:var(--ink-soft); line-height:1.5;}
  .checklist{
    background:var(--navy); color:var(--paper);
    padding:22px; margin-top:26px;
  }
  .checklist h4{
    margin:0 0 14px; font-family:'Space Mono',monospace; font-size:12px;
    text-transform:uppercase; letter-spacing:.08em; color:#e3b94a;
  }
  .checklist ul{margin:0; padding-left:0; list-style:none;}
  .checklist li{
    display:flex; gap:10px; margin-bottom:10px; font-size:13.5px; line-height:1.5;
  }
  .checklist li::before{content:"✓"; color:#8fc7c2; font-weight:700;}

  footer{
    text-align:center; padding:26px; color:var(--ink-soft);
    font-family:'Space Mono',monospace; font-size:10.5px;
    letter-spacing:.04em; text-transform:uppercase;
  }

  .toast{
    position:fixed; bottom:22px; left:50%; transform:translateX(-50%) translateY(20px);
    background:var(--ink); color:var(--paper);
    padding:10px 18px; font-size:13px;
    font-family:'Space Mono',monospace;
    opacity:0; pointer-events:none;
    transition:all .25s ease;
    z-index:100;
  }
  .toast.show{opacity:1; transform:translateX(-50%) translateY(0);}
</style>
</head>
<body>

